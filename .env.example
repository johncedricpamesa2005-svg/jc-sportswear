# ==========================================
# EXPRESS BACKEND SETTINGS (Local & Render)
# ==========================================
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# ==========================================
# MYSQL DATABASE SETTINGS (XAMPP or Cloud MySQL: Aiven / Railway / TiDB)
# Option 1: Full Connection URI (recommended for Cloud MySQL)
# MYSQL_URI=mysql://user:password@host:port/jc_sportswear_db?ssl={"rejectUnauthorized":true}
# Option 2: Individual Parameters (used for local XAMPP by default)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jc_sportswear_db
DB_SSL=false

# ==========================================
# FIREBASE ADMIN CREDENTIALS (Render Env Var)
# Locally, ./serviceAccountKey.json is used automatically if present.
# On Render, paste the entire JSON content into FIREBASE_SERVICE_ACCOUNT_JSON.
# ==========================================
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ==========================================
# FRONTEND SETTINGS (Netlify Env Var)
# Leave empty locally to use Vite's /api proxy.
# On Netlify, set to your Render backend URL, e.g. https://jc-sportswear-api.onrender.com
# ==========================================
VITE_API_URL=
